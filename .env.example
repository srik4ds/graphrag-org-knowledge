# Copy to .env and fill in the values marked REQUIRED.
#   cp .env.example .env

# ---- Provider ----------------------------------------------------------------
# nebius  = any OpenAI-compatible API (Nebius, OpenAI, Groq, local Ollama via NEBIUS_BASE_URL)
# offline = no API needed: rule-based LLM + hashing embeddings (see graphrag/offline.py)
LLM_PROVIDER=nebius

# ---- Nebius (OpenAI-compatible API) ------------------------------------------
# REQUIRED
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Pick models that appear in your Nebius model list
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct
EMBEDDING_MODEL=BAAI/bge-en-icl

# ---- Neo4j AuraDB Free (or local Neo4j 5.11+) --------------------------------
# REQUIRED: the connection URI shown when you create the AuraDB instance
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
# REQUIRED
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- Chunking (box 4B) --------------------------------------------------------
PARENT_CHUNK_TOKENS=1024
CHILD_CHUNK_TOKENS=256
CHILD_CHUNK_OVERLAP=32

# ---- Retrieval (boxes Q3A, Q3B) ----------------------------------------------
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
FINAL_CHILD_TOP_K=5
# none | llm   (llm adds about 1 to 2 s)
RERANK_MODE=none
ENABLE_TEXT2CYPHER=true

# ---- Generation and grounding (boxes Q4 to Q6) -------------------------------
MAX_CONTEXT_TOKENS=6000
# share of claims that must be supported
GROUNDING_THRESHOLD=0.8

# ---- Misc ---------------------------------------------------------------------
# Fixes "today" for questions like "the last audit". The synthetic data is set in October 2026.
TODAY=2026-10-19
